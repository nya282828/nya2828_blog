---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type MediaType = 'img' | 'html' | 'chart' | 'video';

type Props = {
  type?: MediaType;
  src?: string | ImageMetadata;
  alt?: string;
  caption?: string;
  title?: string;
};

const { type = 'img', src, alt = '', caption, title } = Astro.props;
const captionText = caption || title || null;
---

<figure class="c-media">
  {type === 'img' && (
    <div class="c-image">
      {typeof src === 'string'
        ? <img src={src} alt={alt} />
        : <Image
            src={src!}
            alt={alt}
            widths={[320, 375, 580, 980, 1040, 1920]}
            sizes={`(max-width: 376px) 320px,
                    (max-width: 581px) 375px,
                    (max-width: 769px) 580px,
                    (max-width: 961px) 960px,
                    (max-width: 1281px) 1040px,
                    1920px`}
          />
      }
    </div>
  )}
  {(type === 'html' || type === 'chart') && (
    <div class="c-chart" aria-label={alt || undefined}>
      <slot />
    </div>
  )}
  {type === 'video' && (
    <div class="c-movie" aria-label={alt || undefined}>
      <slot />
    </div>
  )}
  {captionText && (
    <figcaption class="c-media__caption t-caption">{captionText}</figcaption>
  )}
</figure>
